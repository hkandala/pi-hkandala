+// patch: a pi started with -ne loads only the extensions it was given, so herdr's default resume
+// (a bare `pi --session`) would bring it back without them. Resume it with its own flags instead:
+// a `pi` launcher's args when one started this pi, else this process's.
+const startArgs = (() => {
+  try {
+    const parent = readFileSync(`/proc/${process.ppid}/cmdline`, "utf8").split("\0").filter(Boolean);
+    if (path.basename(parent[0] ?? "") === "pi") return parent.slice(1);
+  } catch {}
+  return process.argv.slice(2);
+})();
+
+function resumeArgv(session: string | undefined): string[] | undefined {
+  if (!session || (!startArgs.includes("-ne") && !startArgs.includes("--no-extensions"))) return undefined;
+  const kept = [];
+  for (let i = 0; i < startArgs.length; i++) {
+    if (["--session", "--fork", "--session-id"].includes(startArgs[i])) i++;
+    else if (!["--continue", "-c", "--resume", "-r", "--no-session"].includes(startArgs[i])) {
+      kept.push(startArgs[i]);
+    }
+  }
+  const argv = ["pi", ...kept, "--session", session];
+  // herdr drops the whole report for an argv past its limits
+  if (argv.length > 64 || Buffer.byteLength(argv.join(" ")) > 8192 || argv.some((a) => /['\x00-\x1f]/.test(a))) {
+    return undefined;
+  }
+  return argv;
+}
